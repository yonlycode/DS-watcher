# ==============================================================================
# Configuration globale de l'Autodeployer
# Copier ce fichier vers /etc/autodeploy/autodeploy.env avec les permissions 600
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Registre Docker Interne (JFrog Artifactory, GitLab Registry, etc.)
# ------------------------------------------------------------------------------
# Nom d'hôte du registre (ex: jfrog.mon-entreprise.fr ou artifactory.mon-entreprise.fr:5000)
REGISTRY_HOST="jfrog.mon-entreprise.fr"

# Utilisateur technique pour docker login (compte de service JFrog / robot)
REGISTRY_USER="ci-service-account"

# Mot de passe, API Key ou Identity Token JFrog
REGISTRY_TOKEN="AKCp8xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 2. GitLab Auto-hébergé (Optionnel si les tags sont interrogés via le registre)
# ------------------------------------------------------------------------------
# URL de base de votre instance GitLab (si vous utilisez l'API GitLab pour les tags)
GITLAB_URL="https://gitlab.mon-entreprise.fr"
GITLAB_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Notifications & Maintenance
# ------------------------------------------------------------------------------
# URL Webhook optionnelle pour les notifications (Slack, Discord, Teams, etc.)
WEBHOOK_URL=""

# Nettoyage automatique des vieilles images Docker orphelines (dangling) après chaque passage
AUTO_PRUNE_IMAGES="true"
