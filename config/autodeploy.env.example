# ==============================================================================
# Configuration globale de l'Autodeployer
# Copier ce fichier vers /etc/autodeploy/autodeploy.env avec les permissions 600
# ==============================================================================

# URL de base de votre instance GitLab auto-hébergée (sans slash final)
GITLAB_URL="https://gitlab.mon-entreprise.com"

# Nom d'hôte du Registry Docker GitLab interne (avec port si applicable, ex: registry.gitlab.mon-entreprise.com:5050)
GITLAB_REGISTRY="registry.gitlab.mon-entreprise.com"

# Utilisateur pour le docker login
# Si vous utilisez un Deploy Token GitLab, mettez le nom du token (ex: deploy-token-prod)
# Si vous utilisez un Personal Access Token ou Project Access Token, mettez votre username ou le token name
GITLAB_USER="deploy-token"

# Jeton d'accès GitLab (Deploy Token avec scopes 'read_registry' et 'read_api')
GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxxxxxx"

# URL Webhook optionnelle pour les notifications (Slack, Discord, Mattermost, etc.)
# Laisser vide si non souhaité
WEBHOOK_URL=""

# Nettoyage automatique des vieilles images Docker orphelines (dangling) après chaque passage
AUTO_PRUNE_IMAGES="true"
