# ==============================================================================
# Configuration d'application pour Autodeploy
# Déposer ce fichier dans /etc/autodeploy/apps.d/<mon-app>.conf
# ==============================================================================

# Nom logique du conteneur en production (ex: 'api-gateway', 'mon-crm', etc.)
APP_NAME="mon-application"

# Chemin du dépôt d'image dans le GitLab Registry (SANS le tag)
IMAGE_REPO="registry.gitlab.mon-entreprise.com/groupe/projet/mon-application"

# [LEGACY / FALLBACK] ID numérique du projet dans GitLab.
# NE PAS RENSEIGNER dans un contexte JFrog : le mode registre v2 (Mode 2 du script,
# /v2/<repo>/tags/list) est LE chemin de prod. Ce champ n'active l'API tags GitLab
# que comme fallback historique (le registry GitLab a un gap connu sur tags/list,
# gitlab-org#600489 — d'où JFrog ici). Laisser vide.
GITLAB_PROJECT_ID=""

# Durée maximale en secondes d'attente pour que le conteneur devienne "healthy" (défaut: 60)
HEALTHCHECK_TIMEOUT=45

# Intervalle de vérification du healthcheck en secondes (défaut: 2)
HEALTHCHECK_INTERVAL=2

# Réseau Docker partagé avec le conteneur Traefik
DOCKER_NETWORK="traefik-net"

# Nom d'hôte public desservi par Traefik
DOMAIN_NAME="app.mon-entreprise.com"

# Arguments passés à 'docker run' pour démarrer l'application
# REMARQUE : Ne pas spécifier --name ni l'image ici, le script s'en charge.
DOCKER_RUN_ARGS=(
  --restart unless-stopped
  --network "$DOCKER_NETWORK"
  
  # Variables d'environnement applicatives
  -e "NODE_ENV=production"
  -e "PORT=3000"
  
  # Volumes / Bind mounts si nécessaire
  # -v "/var/data/mon-application:/data"

  # Limites de ressources recommandées
  --memory "512m"
  --cpus "1.0"

  # ============================================================================
  # Configuration Traefik (Découverte dynamique par labels)
  # ============================================================================
  --label "traefik.enable=true"
  --label "traefik.http.routers.${APP_NAME}.rule=Host(\`${DOMAIN_NAME}\`)"
  --label "traefik.http.routers.${APP_NAME}.entrypoints=websecure"
  --label "traefik.http.routers.${APP_NAME}.tls=true"
  --label "traefik.http.routers.${APP_NAME}.tls.certresolver=letsencrypt"
  
  # Port interne sur lequel l'application écoute DANS le conteneur
  --label "traefik.http.services.${APP_NAME}.loadbalancer.server.port=3000"

  # ============================================================================
  # Healthcheck TRAEFIK (CRUCIAL — pas le HEALTHCHECK Docker)
  # Le provider Docker de Traefik ne lit PAS .State.Health : il route dès la
  # découverte des labels. Ces labels font qu'un candidat pas prêt est évincé
  # par Traefik LUI-MÊME, même si le script se trompe de fenêtre de bascule.
  # ============================================================================
  --label "traefik.http.services.${APP_NAME}.loadbalancer.healthcheck.path=/health"
  --label "traefik.http.services.${APP_NAME}.loadbalancer.healthcheck.interval=3s"
  --label "traefik.http.services.${APP_NAME}.loadbalancer.healthcheck.timeout=2s"

  # ============================================================================
  # Healthcheck Docker (CRUCIAL pour le zéro downtime)
  # Le conteneur n'est considéré prêt que quand ce test réussit.
  #
  # wget, PAS curl : node:alpine, nginx:alpine, eclipse-temurin:jdk-alpine, etc.
  # n'embarquent PAS curl. Un healthcheck qui appelle un binaire absent échoue
  # toujours -> le candidat est jugé unhealthy -> déploiement refusé pour une raison
  # qui n'a rien à voir avec l'application. wget busybox est, lui, présent partout.
  # ============================================================================
  --health-cmd "wget -q -O - http://localhost:3000/health >/dev/null || exit 1"
  --health-interval 3s
  --health-timeout 2s
  --health-retries 3
  --health-start-period 5s
)

# ==============================================================================
# Budgets de temps (par app)
# ==============================================================================
# Le `docker pull` est borné : un registre qui garde le socket ouvert sans envoyer
# de données gèlerait le cycle pour toutes les apps suivantes.
# PULL_TIMEOUT=300

# ==============================================================================
# Exigence de HEALTHCHECK
# ==============================================================================
# Par défaut, une image SANS HEALTHCHECK Docker est REFUSÉE au déploiement : sans
# lui, le script ne peut pas distinguer "l'app sert du contenu" de "le process
# tourne dans le vide", et la bascule se fait à l'aveugle.
# Si vous assumez ce risque pour cette app, décommentez :
# ALLOW_NO_HEALTHCHECK=true
# NO_HEALTHCHECK_STABLE_SECONDS=6   # stabilité du process exigée (pas une validation applicative)

# ==============================================================================
# Hooks (optionnels)
# ==============================================================================
# Exécutés via un wrapper qui loggue le hook par son NOM, capture le code de
# sortie et pousse un webhook d'alerte identifiant le hook fautif.
#
#   pre-deploy  : après le pull, AVANT tout changement d'état. Un échec annule le
#                 déploiement de cette app (l'ancien conteneur n'est pas touché).
#   post-deploy : APRÈS la bascule. Un échec ne défait PAS la bascule (elle est
#                 déjà effective) mais fait sortir le cycle en erreur.
#
# Variables exposées au hook (exportées, visibles par ses sous-processus) :
#   HOOK_PHASE, APP_NAME, IMAGE_REPO, LATEST_TAG, TARGET_IMAGE,
#   CURRENT_CONTAINER, NEXT_CONTAINER, CONF_FILE
#
# PRE_DEPLOY_CMD="echo '[$HOOK_PHASE] $APP_NAME -> $TARGET_IMAGE'"
# POST_DEPLOY_CMD="curl -fsS -X POST https://ma-ci.example.com/hooks/deployed -d \"app=$APP_NAME&tag=$LATEST_TAG\""
